<?xml version="1.0" encoding="UTF-8"?>
<!-- JCart Web Application Configuration -->
<!-- Defines application-level settings including resource references -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee 
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="false">

    <display-name>JCart</display-name>

    <!-- Database connection pool resource reference -->
    <!-- References the JNDI data source configured in Tomcat context.xml -->
    <resource-ref>
        <res-ref-name>jdbc/JCart</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <!-- Product Controller -->
    <servlet>
        <servlet-name>ProductController</servlet-name>
        <servlet-class>controller.ProductController</servlet-class>
        <async-supported>true</async-supported>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductController</servlet-name>
        <url-pattern>/products/*</url-pattern>
    </servlet-mapping>
</web-app>