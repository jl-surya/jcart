<?xml version="1.0" encoding="UTF-8"?>
<!-- JCart Web Application Configuration -->
<!-- Defines application-level settings including resource references -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         version="5.0">

    <display-name>JCart</display-name>

    <!-- Database connection pool resource reference -->
    <!-- References the JNDI data source configured in Tomcat context.xml -->
    <resource-ref>
        <res-ref-name>jdbc/JCart</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>